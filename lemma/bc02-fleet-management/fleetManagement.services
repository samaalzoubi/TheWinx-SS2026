import datatypes from "fleetManagement.data" as domain

public functional microservice com.winx.fleet.FleetManagement {

    interface vehicleRegistration {
        ---
        Register a new vehicle in the fleet.

        @required requestDto the vehicle details including type, pricing, restrictions, and location
        ---
        registerVehicle(
            sync requestDto : domain::fleetManagement.CreateVehicleRequest,
            sync out responseDto : domain::fleetManagement.VehicleResponse
        );

        ---
        Update a vehicle's description, pricing, and usage restrictions.

        @required vehicleId the unique identifier of the vehicle to update
        @required requestDto the updated vehicle fields
        ---
        updateVehicle(
            sync vehicleId : long,
            sync requestDto : domain::fleetManagement.UpdateVehicleRequest,
            sync out responseDto : domain::fleetManagement.VehicleResponse,
            sync out fault notFound : string
        );

        ---
        Remove a vehicle from the fleet. Rejected while the vehicle is BOOKED.

        @required vehicleId the unique identifier of the vehicle to delete
        ---
        deleteVehicle(
            sync vehicleId : long,
            sync out fault notFound : string,
            sync out fault invalidState : string
        );
    }

    interface vehicleQuery {
        ---
        Retrieve a single vehicle by its ID.

        @required vehicleId the unique identifier of the vehicle
        ---
        getVehicleById(
            sync vehicleId : long,
            sync out responseDto : domain::fleetManagement.VehicleResponse,
            sync out fault notFound : string
        );

        ---
        List vehicles, optionally filtered by owning provider.

        @param providerId optional provider filter
        ---
        getVehicles(
            sync providerId? : long,
            sync out vehicles : domain::fleetManagement.VehicleResponses
        );

        ---
        Find available vehicles near a given geographic position, with optional type, price, age, and duration filters.

        @required lat the latitude of the search center point
        @required lon the longitude of the search center point
        @required radiusKm the search radius in kilometers
        @param vehicleType optional vehicle type filter (E_SCOOTER, BICYCLE, E_BIKE, E_CAR)
        @param maxPrice optional maximum price per unit
        @param minAge optional minimum required rider age
        @param maxDurationMinutes optional maximum rental duration in minutes
        ---
        findAvailableNear(
            sync lat : double,
            sync lon : double,
            sync radiusKm : double,
            sync vehicleType? : string,
            sync maxPrice? : double,
            sync minAge? : int,
            sync maxDurationMinutes? : int,
            sync out vehicles : domain::fleetManagement.VehicleResponses
        );
    }

    interface fleetStatus {
        ---
        Update the current GPS location of a vehicle.

        @required vehicleId the unique identifier of the vehicle
        @required requestDto the new latitude and longitude coordinates
        ---
        updateLocation(
            sync vehicleId : long,
            sync requestDto : domain::fleetManagement.UpdateLocationRequest,
            sync out responseDto : domain::fleetManagement.VehicleResponse,
            sync out fault notFound : string
        );

        ---
        Change the operational status of a vehicle (AVAILABLE or BOOKED).

        @required vehicleId the unique identifier of the vehicle
        @required requestDto the new status value to apply
        ---
        updateStatus(
            sync vehicleId : long,
            sync requestDto : domain::fleetManagement.UpdateStatusRequest,
            sync out responseDto : domain::fleetManagement.VehicleResponse,
            sync out fault notFound : string
        );
    }
}
