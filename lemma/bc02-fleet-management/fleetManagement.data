context fleetManagement {

    // @Entity
    // @Table(name = "vehicles")
    structure Vehicle<entity, aggregate> {

        // @Id
        // @GeneratedValue(strategy = GenerationType.IDENTITY)
        long id<identifier>,

        // Provider reference from Identity & Access bounded context
        long providerId,

        string name<neverEmpty>,

        VehicleType type,

        string description,

        VehicleStatus status,

        double currentLatitude,

        double currentLongitude,

        decimal pricePerUnit,

        BillingModel billingModel,

        int maxDurationMinutes,

        int maxKilometers,

        int minAge,

        int maxPersons,

        procedure updateDetails(
            string name,
            VehicleType type,
            string description,
            decimal pricePerUnit,
            int maxDurationMinutes,
            int maxKilometers,
            int minAge,
            int maxPersons
        ),

        procedure updateLocation(
            double currentLatitude,
            double currentLongitude
        ),

        procedure updateStatus(
            VehicleStatus status
        )
    }

    enum VehicleType {
        E_SCOOTER,
        BICYCLE,
        E_BIKE,
        E_CAR
    }

    enum VehicleStatus {
        AVAILABLE,
        BOOKED
    }

    enum BillingModel {
        PER_DAY,
        PER_HOUR,
        PER_KILOMETER
    }

    collection Vehicles {
        Vehicle vehicle
    }

    domain service VehicleRegistrationService {
        createVehicle(long providerId, Vehicle vehicle) : Vehicle
        updateVehicle(long vehicleId, Vehicle vehicle) : Vehicle
        deleteVehicle(long vehicleId)
    }

    domain service FleetStatusService {
        getFleet(long providerId) : Vehicles
        updateLocation(long vehicleId, double latitude, double longitude) : Vehicle
        updateStatus(long vehicleId, VehicleStatus status) : Vehicle
    }

    domain service VehicleAvailabilityService {
        findAvailableNear(double latitude, double longitude, double radius) : Vehicles
    }
}